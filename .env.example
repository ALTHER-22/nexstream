# =============================================================================
# NEXSTREAM — Variables de Entorno
# Copia este archivo como .env y configura tus valores
# NUNCA subas .env a Git
# =============================================================================

# ─── Flask ────────────────────────────────────────────────────────────────────
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=cambia-esta-clave-secreta-en-produccion-min-32-chars

# ─── Base de Datos ────────────────────────────────────────────────────────────
# Desarrollo (SQLite)
DATABASE_URL=sqlite:///nexstream.db

# Producción (PostgreSQL) — descomenta en producción
# DATABASE_URL=postgresql://usuario:password@localhost:5432/nexstream_db

# ─── Email ────────────────────────────────────────────────────────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=tu-email@gmail.com
MAIL_PASSWORD=tu-app-password
MAIL_DEFAULT_SENDER=NEXSTREAM <tu-email@gmail.com>

# ─── Seguridad ────────────────────────────────────────────────────────────────
WTF_CSRF_SECRET_KEY=otra-clave-csrf-diferente-muy-segura

# ─── Caché ────────────────────────────────────────────────────────────────────
CACHE_TYPE=SimpleCache
CACHE_DEFAULT_TIMEOUT=300

# ─── Subidas ──────────────────────────────────────────────────────────────────
MAX_CONTENT_LENGTH=524288000
UPLOAD_FOLDER=app/static/uploads

# ─── Plataforma ───────────────────────────────────────────────────────────────
PLATFORM_NAME=NEXSTREAM
PLATFORM_TAGLINE=Tu universo de entretenimiento
ADMIN_EMAIL=admin@nexstream.com

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATELIMIT_DEFAULT=200 per day;50 per hour
RATELIMIT_STORAGE_URL=memory://
